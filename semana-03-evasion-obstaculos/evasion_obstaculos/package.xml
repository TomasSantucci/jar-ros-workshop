<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>evasion_obstaculos</name>
  <version>0.1.0</version>
  <description>Semana 03 del Challenge JAR: maquina de estados para avanzar, detectar un choque inminente con el lidar y girar un angulo fijo (medido con odometria) antes de retomar la marcha.</description>
  <maintainer email="rafadiaz71@gmail.com">AIR Club UdeSA</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>python3-numpy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>